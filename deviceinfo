# Ubuntu Touch port: Xiaomi Redmi 10 (selene), MediaTek Helio G85 (MT6768)
# Halium 12 on the stock MIUI 14 (Android 12) vendor.
deviceinfo_name="Redmi 10"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="selene"
deviceinfo_arch="aarch64"
deviceinfo_halium_version="12"
deviceinfo_ubuntu_touch_release="24.04-2.x"

# Kernel: Xiaomi's 4.19 MT6768 tree (MiCode fire-t-oss) with the selene board
# support ported to it, branch halium-12.
deviceinfo_kernel_source="https://github.com/rocklouis055/kernel-xiaomi-selene.git"
deviceinfo_kernel_source_branch="halium-12"
deviceinfo_kernel_defconfig="selene_defconfig halium.config"
# systempart: Ubuntu Touch lives in the logical system partition of the
# current slot (system_a); the initramfs adds the slot suffix.
deviceinfo_kernel_cmdline="bootopt=64S3,32N2,64N2 buildvariant=userdebug systempart=/dev/mapper/system systemd.unified_cgroup_hierarchy=0"
deviceinfo_kernel_clang_compile="true"
deviceinfo_kernel_llvm_compile="true"
deviceinfo_kernel_use_lld="true"
# Android clang 11.0.2 (the version the tree is built and tested with)
deviceinfo_kernel_clang_branch="android11-gsi"
deviceinfo_kernel_clang_revision="r383902"
deviceinfo_kernel_image_name="Image.gz"
# The few =m options are unused; everything needed is built in. The
# MediaTek connectivity modules are built separately (scripts/).
deviceinfo_kernel_disable_modules="true"

# Boot image, as the stock one: header v2, 2 KiB pages. The bootloader (LK)
# only accepts the device tree as a DT table in the dtb section.
deviceinfo_bootimg_header_version="2"
deviceinfo_bootimg_os_version="12"
deviceinfo_bootimg_os_patch_level="2024-04"
deviceinfo_bootimg_partition_size="67108864"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_offset_base="0x40078000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x07c08000"
deviceinfo_flash_offset_second="0x00e88000"
deviceinfo_flash_offset_tags="0x0bc08000"
deviceinfo_flash_offset_dtb="0x0bc08000"
deviceinfo_dtb="mediatek/mt6768-selene.dtb"
deviceinfo_dtb_has_dt_table="true"
deviceinfo_dtb_id="0x00000000"
# The stock dtbo partition is kept (the charging setup is tuned for it).
deviceinfo_skip_dtbo_partition="true"

# No recovery partition on selene: the UBports recovery is part of the boot
# image ("unified recovery"). LK passes androidboot.force_normal_boot=1 on a
# normal boot only, so Volume Up + Power (or `reboot recovery`) starts it.
deviceinfo_has_recovery_partition="false"
deviceinfo_use_unified_recovery="true"
deviceinfo_unified_recovery_ui_density="xxhdpi"

deviceinfo_rootfs_image_sector_size="4096"
# super is 8.7 GB; the UBports recovery grows system_a to this after removing
# the unused stock system_ext_a and system_b
# (ramdisk-recovery-overlay/system/etc/init/selene-systemimage.rc)
deviceinfo_system_partition_size="4500M"
